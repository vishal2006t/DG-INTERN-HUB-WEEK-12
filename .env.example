# =================================================================
# DG INTERNS HUB (WEEK 12 CAPSTONE) — ENVIRONMENT TEMPLATE
# Copy this file to '.env' locally, or set values in Render / Vercel.
# NEVER commit your actual '.env' file or secret keys.
# =================================================================

# Backend Network & Runtime Mode
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local Community Server)
# Local dev option:
MONGODB_URI=mongodb://127.0.0.1:27017/dg_interns_hub
# Production MongoDB Atlas example (populate with real credentials in Render):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dg_interns_hub?retryWrites=true&w=majority

# JWT Authentication (Mandatory strong 32+ char secret in production)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_strong_64_char_random_hex_secret_for_production
JWT_EXPIRES_IN=7d

# CORS Allowed Client / Frontend Origins (Week 12 isolated deployment)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Comma-separated additional allowed origins (example Week 12 Vercel URL):
CORS_ORIGINS=http://localhost:5173,https://dg-intern-hub-week-12.vercel.app

# Frontend Vite Build Configuration (Safe public variables)
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
# Production Vercel env example (set in Vercel Project Settings -> Environment Variables):
# VITE_API_BASE_URL=https://dg-intern-hub-week-12-api.onrender.com/api
